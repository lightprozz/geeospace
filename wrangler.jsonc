{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geeospace-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "geeospace-local" }],
  "d1_databases": [{ "binding": "DB", "database_name": "geeospace-local", "database_id": "local-geeospace", "migrations_dir": "db/migrations" }],
  "r2_buckets": [{ "binding": "LEARNING_FILES", "bucket_name": "geeospace-learning-local" }],
  "vars": { "APP_ENV": "development", "APP_ORIGIN": "http://127.0.0.1:8787" }
}
