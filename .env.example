# Browser-side Gee-O integration. Leave URLs blank to disable sign-in and API calls.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_API_URL=
# Optional shared parent domain, e.g. .example.com. Blank means host-only cookies.
NEXT_PUBLIC_COOKIE_DOMAIN=
# Optional Google OAuth auth-code button; no Google scripts load when blank.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
